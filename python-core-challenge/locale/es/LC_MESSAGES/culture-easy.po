#: ../../../culture-easy.rst:4
msgid "Culture Easy"
msgstr "Cultura fácil"

#: ../../../culture-easy.rst:11
msgid "Where does the name \"Python\" come from?"
msgstr "¿De dónde viene el nombre \"Python\"?"

#: ../../../culture-easy.rst:20
msgid "The snake species."
msgstr "La especie de serpiente."

#: ../../../culture-easy.rst:21
msgid "The BBC comedy show *Monty Python's Flying Circus*."
msgstr "El programa de humor de la BBC *Monty Python's Flying Circus*."

#: ../../../culture-easy.rst:22
msgid "Guido van Rossum's pet."
msgstr "La mascota de Guido van Rossum."

#: ../../../culture-easy.rst:23
msgid "A contraction of \"Pythagoras\"."
msgstr "Una contracción de \"Pitágoras\"."

