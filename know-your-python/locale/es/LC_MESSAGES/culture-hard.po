#: ../../../culture-hard.rst:4
msgid "Culture Hard"
msgstr "Cultura difícil"

#: ../../../culture-hard.rst:11
msgid "What happens when you run this code?"
msgstr "¿Qué ocurre cuando ejecutas este código?"

#: ../../../culture-hard.rst:24
#, python-brace-format
msgid "Python starts allowing ``{ }`` blocks instead of indentation."
msgstr "Python empieza a permitir bloques con ``{ }`` en lugar de sangría."

#: ../../../culture-hard.rst:25
msgid "It silently does nothing."
msgstr "No hace nada de forma silenciosa."

#: ../../../culture-hard.rst:26
msgid "It raises ``SyntaxError: not a chance``."
msgstr "Lanza ``SyntaxError: not a chance``."

#: ../../../culture-hard.rst:27
msgid "It raises ``ImportError: no module named braces``."
msgstr "Lanza ``ImportError: no module named braces``."

