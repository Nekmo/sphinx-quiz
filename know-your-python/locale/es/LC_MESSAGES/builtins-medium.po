#: ../../../builtins-medium.rst:133
msgid ""
"``bool`` on a string is about emptiness, not content. Any non-empty string "
"is truthy, so ``\"False\"`` becomes ``True``."
msgstr ""
"``bool`` sobre una cadena depende de si está vacía, no de su contenido. "
"Cualquier cadena no vacía tiene valor de verdad verdadero, así que "
"``\"False\"`` se convierte en ``True``."

#: ../../../builtins-medium.rst:150
msgid "``10``"
msgstr "``10``"

#: ../../../builtins-medium.rst:151
msgid "``10.0``"
msgstr "``10.0``"

#: ../../../builtins-medium.rst:158
msgid ""
"The second argument is the base. ``\"10\"`` in base 2 equals decimal ``2``."
msgstr ""
"El segundo argumento es la base. ``\"10\"`` en base 2 equivale al decimal "
"``2``."

#: ../../../builtins-medium.rst:174
msgid "``[(1, 'a'), (2, 'b'), (3, None)]``"
msgstr "``[(1, 'a'), (2, 'b'), (3, None)]``"

#: ../../../builtins-medium.rst:175 ../../../builtins-medium.rst:375
msgid "``[(1, 'a'), (2, 'b')]``"
msgstr "``[(1, 'a'), (2, 'b')]``"

