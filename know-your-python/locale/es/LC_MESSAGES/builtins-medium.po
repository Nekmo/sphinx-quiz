msgid "``[('a', 1), ('b', 2)]``"
msgstr "``[('a', 1), ('b', 2)]``"

#: ../../../builtins-medium.rst:381
msgid ""
"The ``start`` argument sets the first counter value, so numbering begins at "
"``1``."
msgstr ""
"El argumento ``start`` fija el primer valor del contador, así que la "
"numeración empieza en ``1``."

#: ../../../builtins-medium.rst:398
