msgid "``[(1, 2, 3), ('a', 'b')]``"
msgstr "``[(1, 2, 3), ('a', 'b')]``"

#: ../../../builtins-medium.rst:182
msgid ""
"``zip`` stops at the shortest iterable, so the trailing ``3`` is dropped."
msgstr ""
"``zip`` se detiene en el iterable más corto, así que el ``3`` final se "
"descarta."

#: ../../../builtins-medium.rst:198
msgid "``[0, 0]``"
msgstr "``[0, 0]``"

